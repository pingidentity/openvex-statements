      "vulnerability": {
        "name": "CVE-2022-42889"
      },
      "products": [
        {
          "@id": "pkg:generic/pingidentity/pingfederate-iks",
          "subcomponents": [
            {
              "@id": "pkg:maven/org.apache.commons/commons-text"
            }
          ]
        }
      ],
      "status": "not_affected",
      "status_notes": "False positive. No PingFederate Integration kits use commons-text methods which implement StringLookup as described in https://nvd.nist.gov/vuln/detail/CVE-2022-42889. All IKs use the replace() method, not the potentially vulnerable createInterpolator() method. None of the replace() overrides contain StringLookup, StringLookupFactory or createInterpolator. See https://commons.apache.org/proper/commons-text/apidocs/src-html/org/apache/commons/text/StringSubstitutor.html.",
      "justification": "component_not_present",
      "timestamp": "2026-11-06T16:13:49Z"
    },
